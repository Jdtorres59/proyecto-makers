# Copia este archivo como .env y llena los valores. El .env nunca se sube al repo.
SUPABASE_URL=
# Llave secreta (sb_secret_...). Salta RLS: solo vive en el servidor.
SUPABASE_SECRET_KEY=

# mock (sin costo) | anthropic | bedrock
AI_PROVIDER=mock
# Opcional: fuerza un modelo de packages/ai/src/modelos.ts para todos los agentes. Los agentes usan "economico" (Haiku 5.5) por defecto; "principal" (Opus 5.5) cuesta unas 40 veces más.
# Vacío = cada agente usa el suyo (principal: Opus 5.5).
AI_MODELO=
# Solo si AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Solo si AI_PROVIDER=bedrock. Nombres propios a propósito: Vercel puede poner AWS_REGION y AWS_ACCESS_KEY_ID con valores que no sirven.
# Región de Bedrock, por ejemplo us-east-1
BEDROCK_REGION=
# Opción A (recomendada en servidor): llave de acceso de un usuario o rol de IAM con permiso bedrock-mantle:CreateInference
BEDROCK_AWS_ACCESS_KEY_ID=
BEDROCK_AWS_SECRET_ACCESS_KEY=
# Solo si las credenciales son temporales
BEDROCK_AWS_SESSION_TOKEN=
# Opción B: llave de API de Bedrock (se usa solo si no hay opción A)
AWS_BEARER_TOKEN_BEDROCK=
# Opcional: ID exacto del modelo en esta cuenta. Por defecto anthropic.claude-opus-5-5 y anthropic.claude-haiku-5-5
BEDROCK_MODELO_PRINCIPAL=
BEDROCK_MODELO_ECONOMICO=

# Tope de gasto en modelo por usuario y por día, en dólares
TOPE_DIARIO_USD=0.5
# Orígenes web que pueden llamar a la API, separados por comas. Vacío = http://localhost:8081 (Expo web local).
# En Vercel: la URL de la app web, por ejemplo https://luca-web.vercel.app
ORIGENES_PERMITIDOS=
# Solo en desarrollo local (en Vercel no se usa)
PORT=8787

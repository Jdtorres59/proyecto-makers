# Copia este archivo como .env y llena los valores. El .env nunca se sube al repo.
SUPABASE_URL=
# Llave secreta (sb_secret_...). Salta RLS: solo vive en el servidor.
SUPABASE_SECRET_KEY=

# mock (sin costo) | anthropic | bedrock
AI_PROVIDER=mock
# Solo si AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Solo si AI_PROVIDER=bedrock (más las credenciales estándar de AWS)
AWS_REGION=

# Tope de gasto en modelo por usuario y por día, en dólares
TOPE_DIARIO_USD=0.5
PORT=8787

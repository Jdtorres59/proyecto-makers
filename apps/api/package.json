{
  "name": "@makers/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/dev.ts",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/server.js --external:hono --external:'hono/*' --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "humo": "tsx --env-file=.env src/humo.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@makers/ai": "workspace:*",
    "@makers/conocimiento": "workspace:*",
    "@makers/core": "workspace:*",
    "@supabase/supabase-js": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "catalog:"
  }
}

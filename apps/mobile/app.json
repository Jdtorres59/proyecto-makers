{
  "expo": {
    "name": "Luca",
    "slug": "makers",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "makers",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "backgroundColor": "#F6EEDC"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#D99A2B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "backgroundColor": "#F6EEDC"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Luca",
      "shortName": "Luca",
      "themeColor": "#D99A2B",
      "backgroundColor": "#F6EEDC"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6EEDC",
          "image": "./assets/marca/splash-claro.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#1D1812",
            "image": "./assets/marca/splash-oscuro.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Luca usa la cámara para tomarle una foto a tu desprendible o a tus papeles.",
          "photosPermission": "Luca abre tus fotos para que elijas un documento."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}

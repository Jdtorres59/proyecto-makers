# Copia este archivo como .env. Todas estas variables son PÚBLICAS: viajan dentro de la app y del sitio web.
# Nunca pongas aquí llaves secretas (la llave secreta de Supabase y la del modelo viven solo en apps/api).

# Proyecto de Supabase: Project Settings > API. La llave publicable, no la secreta.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Dirección de la API (apps/api). En local http://localhost:8787; en un celular físico, la IP de tu computador
# en la red local; en producción, el dominio de Vercel de la API (sin barra al final).
EXPO_PUBLIC_API_URL=http://localhost:8787

# Modo demostración (los datos ficticios de Valentina, sin cuenta) con la entrada "Probar sin cuenta" en el login.
# "si" lo muestra; cualquier otro valor lo oculta. En desarrollo siempre está.
EXPO_PUBLIC_MODO_DEMO=si
